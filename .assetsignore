# Everything here is repository content that must NOT be published as part of
# the site. `assets.directory` is the repo root so the frontend keeps the
# layout it has always had (index.html, js/, css/, pages/, assets/) rather
# than being moved into a build folder it does not need.
node_modules
.git
.github
.wrangler
src
tests
tools
migrations
package.json
package-lock.json
wrangler.jsonc
.assetsignore
.gitignore
README.md
AUDIT.md
DEPLOYMENT.md
MESSENGER_SETUP.md
WHATSAPP_SETUP.md
WEBSITE_FORMS_SETUP.md

# Secret files, if a developer ever creates one in the repository root. They
# are gitignored, which keeps them out of the REPOSITORY -- this keeps them
# out of the published SITE, which is a different thing and matters just as
# much when assets.directory is the root.
.dev.vars
.dev.vars.*
.env
.env.*

# Database exports (wrangler d1 export) hold every customer record. They are
# gitignored too, but a backup saved in the repository root would otherwise be
# published by the next deploy, because assets.directory is the root.
backup*.sql
*.sql
